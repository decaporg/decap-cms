{
  "name": "decap-cms-lib-util",
  "description": "Shared utilities for Decap CMS.",
  "version": "3.8.1",
  "repository": "https://github.com/decaporg/decap-cms/tree/main/packages/decap-cms-lib-util",
  "bugs": "https://github.com/decaporg/decap-cms/issues",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "main": "dist/decap-cms-lib-util.js",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "keywords": [
    "decap-cms"
  ],
  "sideEffects": false,
  "scripts": {
    "develop": "pnpm run build:babel --watch",
    "build": "cross-env NODE_ENV=production webpack",
    "build:esm": "run-p build:types build:babel",
    "build:babel": "cross-env NODE_ENV=esm babel src --out-dir dist/esm --ignore \"**/__tests__\" --root-mode upward --extensions \".js,.jsx,.ts,.tsx\"",
    "build:types": "tsc"
  },
  "dependencies": {
    "js-sha256": "catalog:",
    "localforage": "catalog:",
    "semaphore": "catalog:"
  },
  "peerDependencies": {
    "common-tags": "catalog:",
    "immutable": "catalog:",
    "lodash": "catalog:"
  },
  "devDependencies": {
    "common-tags": "catalog:"
  }
}
