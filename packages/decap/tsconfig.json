{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "target": "ES2020",
    "outDir": "dist",
    "baseUrl": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "paths": {
      "decap-turbo-api": ["../decap-turbo-api/src"],
      "decap-cms-lib-util/src/APIUtils": ["../decap-cms-lib-util/src/APIUtils.ts"]
    },
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.spec.ts"]
}
