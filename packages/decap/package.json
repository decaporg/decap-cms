{
  "name": "decap",
  "description": "The Decap command line: run the local proxy server for the CMS, manage Decap Turbo from your terminal, and connect AI agents to it over MCP",
  "version": "0.1.0",
  "repository": "https://github.com/decaporg/decap-cms/tree/main/packages/decap",
  "bugs": "https://github.com/decaporg/decap-cms/issues",
  "license": "MIT",
  "keywords": [
    "decap-cms",
    "decap-turbo",
    "cli",
    "mcp",
    "proxy",
    "local-backend"
  ],
  "type": "module",
  "exports": {
    "./dev": {
      "require": "./dist/dev.cjs",
      "default": "./dist/dev.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "decap": "./dist/cli.cjs"
  },
  "scripts": {
    "build": "webpack --config webpack.config.cjs",
    "test": "cd ../.. && cross-env NODE_ENV=test jest packages/decap/ packages/decap-turbo-api/",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hapi/joi": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "async-mutex": "catalog:",
    "cors": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "morgan": "catalog:",
    "simple-git": "catalog:",
    "what-the-diff": "catalog:",
    "winston": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/hapi__joi": "catalog:",
    "@types/morgan": "catalog:",
    "@types/node": "catalog:",
    "decap-cms-lib-util": "workspace:*",
    "decap-turbo-api": "workspace:*",
    "ts-loader": "catalog:",
    "tsconfig-paths-webpack-plugin": "catalog:",
    "typescript": "^5.9.3",
    "webpack": "catalog:",
    "webpack-cli": "catalog:",
    "webpack-node-externals": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
