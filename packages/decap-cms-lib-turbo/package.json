{
  "name": "decap-cms-lib-turbo",
  "description": "Code shared by the Decap Turbo backends of Decap CMS: the Turbo session, the proxied fetch, the content cache and the login page.",
  "version": "3.5.1",
  "repository": "https://github.com/decaporg/decap-cms/tree/main/packages/decap-cms-lib-turbo",
  "bugs": "https://github.com/decaporg/decap-cms/issues",
  "module": "dist/esm/index.js",
  "main": "dist/decap-cms-lib-turbo.js",
  "license": "MIT",
  "files": [
    "src/",
    "dist/"
  ],
  "keywords": [
    "decap-cms",
    "turbo",
    "supabase"
  ],
  "sideEffects": false,
  "scripts": {
    "develop": "pnpm run build:esm --watch",
    "build": "cross-env NODE_ENV=production webpack",
    "build:esm": "cross-env NODE_ENV=esm babel src --out-dir dist/esm --ignore \"**/__tests__\" --root-mode upward --extensions \".js,.jsx,.ts,.tsx\""
  },
  "peerDependencies": {
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "decap-cms-lib-util": "workspace:*",
    "decap-cms-ui-default": "workspace:*",
    "prop-types": "catalog:",
    "react": "catalog:"
  }
}
