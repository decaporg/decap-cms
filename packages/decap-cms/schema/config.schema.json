{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/decap-cms/schema/config.schema.json",
  "title": "Decap CMS config.yml",
  "description": "IDE-facing JSON Schema for a Decap CMS `config.yml`. Hand-maintained to mirror the structural shape of the runtime schema in `src/core/lib/validateConfig.ts` (`getConfigSchema()`) as of this file's last update — that TypeScript file remains the single source of truth for actual validation; this schema exists only to give editors (VS Code + yaml-language-server, JetBrains, etc.) autocompletion and inline hints. See packages/decap-cms/README.md#json-schema-editor-autocompletion for usage.",
  "$comment": "Deliberately omits keywords the runtime validator supports but that only make sense with a live widget/backend/entry-codec registry: the custom `widgets` dispatch keyword (per-widget field property schemas, resolved from `registerWidget({ schema })` calls at app-bootstrap time), the custom `instanceof` keyword (`pattern: [RegExp, string]`), the custom `uniqueItemProperties` keyword (ajv-keywords-style; not part of standard JSON Schema), and the `extension`/`frontmatter_delimiter` -> `format` inference rules driven by `getExtensionFormatters()`/`getFrontmatterFormats()`. None of that is enforceable statically without importing the whole app, and the runtime validator still catches all of it at CMS startup. `field` objects intentionally have no `additionalProperties: false` for this reason -- unrecognized keys are widget-specific, not typos.",
  "type": "object",
  "definitions": {
    "localeCode": {
      "type": "string",
      "minLength": 2,
      "maxLength": 10,
      "pattern": "^[a-zA-Z-_]+$"
    },
    "i18nStructure": {
      "type": "object",
      "properties": {
        "structure": {
          "type": "string",
          "enum": ["multiple_folders", "multiple_files", "single_file"]
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/localeCode" },
          "uniqueItems": true
        },
        "default_locale": { "$ref": "#/definitions/localeCode" }
      }
    },
    "i18nField": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "enum": ["translate", "duplicate", "none"] }
      ]
    },
    "i18nRoot": {
      "type": "object",
      "properties": {
        "structure": {
          "type": "string",
          "enum": ["multiple_folders", "multiple_files", "single_file"]
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/localeCode" },
          "uniqueItems": true
        },
        "default_locale": { "$ref": "#/definitions/localeCode" }
      },
      "required": ["structure", "locales"]
    },
    "viewFilters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "field": { "type": "string" },
          "pattern": { "oneOf": [{ "type": "boolean" }, { "type": "string" }] }
        },
        "additionalProperties": false,
        "required": ["label", "field", "pattern"]
      }
    },
    "viewGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "field": { "type": "string" },
          "pattern": { "type": "string" }
        },
        "additionalProperties": false,
        "required": ["label", "field"]
      }
    },
    "field": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "widget": {
          "type": "string",
          "description": "Built-in widgets shipped by this package plus any custom widgets registered with `CMS.registerWidget`.",
          "examples": [
            "boolean",
            "code",
            "color",
            "datetime",
            "file",
            "hidden",
            "image",
            "list",
            "map",
            "markdown",
            "number",
            "object",
            "relation",
            "richtext",
            "select",
            "string",
            "text",
            "unknown",
            "uuid"
          ]
        },
        "required": { "type": "boolean" },
        "unique": {
          "type": "boolean",
          "description": "Validated against the collection's other entries at save time (DCMS-1422, partial)."
        },
        "i18n": { "$ref": "#/definitions/i18nField" },
        "hint": { "type": "string" },
        "pattern": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "description": "A regular expression as a string, e.g. '^[a-z]+$' (a literal RegExp value is also accepted at runtime but can't be expressed in JSON)."
            },
            { "type": "string" }
          ]
        },
        "field": {
          "$ref": "#/definitions/field",
          "description": "Used by the `list` widget for a single-field-per-item shorthand."
        },
        "fields": {
          "$ref": "#/definitions/fields",
          "description": "Used by the `object`/`list` widgets for nested fields."
        },
        "types": {
          "$ref": "#/definitions/fields",
          "description": "Used by the `list` widget for variable-type (typed) list items."
        },
        "group": {
          "type": "string",
          "description": "Reusable-field-group reference: expands to `field_groups[group]`'s field list in place of this entry. Mutually exclusive with `name` and all other field properties."
        },
        "visualEditing": {
          "type": "boolean",
          "description": "Field-level opt-out from steganographic encoding, effective once the collection has opted in via `editor.visualEditing`."
        }
      },
      "oneOf": [{ "required": ["name"] }, { "required": ["group"] }]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/field" }
    },
    "file": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "label_singular": { "type": "string" },
        "description": { "type": "string" },
        "file": { "type": "string" },
        "preview_path": { "type": "string" },
        "preview_path_date_field": { "type": "string" },
        "preview_path_preserve_slashes": { "type": "boolean" },
        "fields": { "$ref": "#/definitions/fields" }
      },
      "required": ["name", "label", "file", "fields"]
    },
    "collection": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "label_singular": { "type": "string" },
        "description": { "type": "string" },
        "folder": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/definitions/file" }
        },
        "identifier_field": { "type": "string" },
        "summary": { "type": "string" },
        "slug": { "type": "string" },
        "path": { "type": "string" },
        "preview_path": { "type": "string" },
        "preview_path_date_field": { "type": "string" },
        "preview_path_preserve_slashes": { "type": "boolean" },
        "create": { "type": "boolean" },
        "publish": { "type": "boolean" },
        "hide": { "type": "boolean" },
        "view_scopes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "edit_scopes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "shortcut": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]$",
          "description": "Single letter/digit for the collection's 'g <key>' keyboard chord."
        },
        "editor": {
          "type": "object",
          "properties": {
            "preview": { "type": "boolean" },
            "visualEditing": { "type": "boolean" }
          }
        },
        "format": { "type": "string" },
        "extension": { "type": "string" },
        "frontmatter_delimiter": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "string" }
            }
          ]
        },
        "fields": { "$ref": "#/definitions/fields" },
        "sortable_fields": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "field": { "type": "string" },
                  "label": { "type": "string" },
                  "default_sort": {
                    "oneOf": [
                      { "type": "boolean" },
                      { "type": "string", "enum": ["asc", "desc"] }
                    ]
                  }
                },
                "additionalProperties": false,
                "required": ["field"]
              }
            ]
          }
        },
        "search_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "sortableFields": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Deprecated camelCase alias for `sortable_fields`, auto-migrated at load time. Mutually exclusive with `sortable_fields`."
        },
        "view_filters": { "$ref": "#/definitions/viewFilters" },
        "view_groups": { "$ref": "#/definitions/viewGroups" },
        "limit": {
          "type": "number",
          "description": "Folder collections only: the most entries the collection may hold, published and unpublished together. Creating more is blocked."
        },
        "nested": {
          "type": "object",
          "properties": {
            "depth": { "type": "number", "minimum": 1, "maximum": 1000 },
            "subfolders": { "type": "boolean" },
            "summary": { "type": "string" }
          },
          "required": ["depth"]
        },
        "meta": {
          "type": "object",
          "properties": {
            "path": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "widget": { "type": "string" },
                "index_file": { "type": "string" }
              },
              "required": ["label", "widget"]
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "i18n": {
          "oneOf": [{ "type": "boolean" }, { "$ref": "#/definitions/i18nStructure" }]
        }
      },
      "required": ["name", "label"],
      "oneOf": [
        { "required": ["files"] },
        { "required": ["folder", "fields"] }
      ],
      "not": {
        "required": ["sortable_fields", "sortableFields"]
      }
    }
  },
  "properties": {
    "backend": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "examples": ["git-gateway", "github", "gitlab", "test-repo"]
        },
        "auth_scope": {
          "type": "string",
          "enum": ["repo", "public_repo"],
          "examples": ["repo", "public_repo"]
        },
        "cms_label_prefix": { "type": "string", "minLength": 1 },
        "open_authoring": { "type": "boolean", "examples": [true] },
        "base_url": { "type": "string" },
        "api_root": { "type": "string" },
        "api_url": { "type": "string" },
        "dev_token": { "type": "string" },
        "proxy_url": {
          "type": "string",
          "description": "Required when `name` is `proxy`. Must be an http(s) or root-relative URL."
        }
      },
      "required": ["name"],
      "if": {
        "properties": { "name": { "enum": ["proxy"] } },
        "required": ["name"]
      },
      "then": {
        "required": ["proxy_url"],
        "properties": { "proxy_url": { "minLength": 1, "pattern": "^(https?://.+|/(?!/).*)$" } }
      }
    },
    "local_backend": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "properties": {
            "url": { "type": "string", "examples": ["http://localhost:8081/api/v1"] },
            "allowed_hosts": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "locale": { "type": "string", "examples": ["en", "fr", "de"] },
    "i18n": { "$ref": "#/definitions/i18nRoot" },
    "site_url": { "type": "string", "examples": ["https://example.com"] },
    "display_url": { "type": "string", "examples": ["https://example.com"] },
    "logo_url": {
      "type": "string",
      "description": "Deprecated, replaced by `logo.src`.",
      "examples": ["https://example.com/images/logo.svg"]
    },
    "logo": {
      "type": "object",
      "properties": {
        "src": { "type": "string", "examples": ["https://example.com/images/logo.svg"] },
        "show_in_header": { "type": "boolean" }
      },
      "required": ["src"]
    },
    "show_preview_links": { "type": "boolean" },
    "media_folder": { "type": "string", "examples": ["assets/uploads"] },
    "public_folder": { "type": "string", "examples": ["/uploads"] },
    "media_folder_relative": { "type": "boolean" },
    "media_processing": {
      "description": "Browser-side processing applied once to an uploaded JPEG, PNG or WebP image before it is stored: resize, centre-crop to an aspect ratio, strip metadata by re-encoding, and optionally convert to JPEG or WebP. Image and file fields can set their own media_processing, which overrides this.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "format": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "default": { "type": "string", "enum": ["jpeg", "webp"] }
          },
          "required": ["enabled", "default"],
          "additionalProperties": false
        },
        "quality": { "type": "number", "minimum": 1, "maximum": 100 },
        "strip_metadata": { "type": "boolean" },
        "width": { "oneOf": [{ "type": "number", "minimum": 1 }, { "type": "null" }] },
        "height": { "oneOf": [{ "type": "number", "minimum": 1 }, { "type": "null" }] },
        "aspect_ratio": {
          "oneOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "string", "pattern": "^\\d+(?:\\.\\d+)?[_:x]\\d+(?:\\.\\d+)?$" },
            { "type": "null" }
          ]
        }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "media_library": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "examples": ["uploadcare"] },
        "config": { "type": "object" }
      },
      "required": ["name"]
    },
    "asset_collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "label": { "type": "string" },
          "label_singular": { "type": "string" },
          "description": { "type": "string" },
          "media_folder": { "type": "string", "examples": ["assets/images"] },
          "public_folder": { "type": "string" },
          "allowed_file_types": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "filename_template": { "type": "string", "examples": ["{{slug}}-{{index}}"] }
        },
        "required": ["name", "label", "media_folder"]
      }
    },
    "publish_mode": {
      "type": "string",
      "enum": ["simple", "editorial_workflow", ""],
      "examples": ["editorial_workflow"]
    },
    "slug": {
      "type": "object",
      "properties": {
        "encoding": { "type": "string", "enum": ["unicode", "ascii"] },
        "clean_accents": { "type": "boolean" }
      }
    },
    "issue_reports": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "examples": ["https://example.com/report-issue"] }
      }
    },
    "field_groups": {
      "type": "object",
      "description": "Named, reusable field lists referenced from collection/file/nested fields via `{ group: '<name>' }`. Keys are group names, values are regular field arrays. Expanded in place during config normalization.",
      "additionalProperties": { "$ref": "#/definitions/fields" }
    },
    "roles": {
      "type": "object",
      "description": "Role name -> scope list, granted to users whose backend payload carries the matching `role`. Per-role validation happens in `normalizeConfig`."
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/collection" }
    },
    "editor": {
      "type": "object",
      "properties": {
        "preview": { "type": "boolean" }
      }
    }
  },
  "required": ["backend", "collections"],
  "anyOf": [
    { "required": ["media_folder"] },
    { "required": ["media_library"] }
  ],
  "not": {
    "$comment": "The local-fs backend has no git/PR layer to stage unpublished drafts against, so publish_mode: editorial_workflow always fails at runtime. See validateConfig.ts's matching post-schema check (DCMS-1860) for the enforced, user-facing error.",
    "properties": {
      "backend": {
        "properties": { "name": { "enum": ["local-fs"] } },
        "required": ["name"]
      },
      "publish_mode": { "enum": ["editorial_workflow"] }
    },
    "required": ["backend", "publish_mode"]
  }
}
