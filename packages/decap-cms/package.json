  "sideEffects": [
    "./dist/app/index.js",
    "./dist/dev-server/**",
    "./src/app/index.ts",
    "./src/dev-server/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js",
      "require": "./dist/decap-cms.cjs",
      "default": "./dist/app/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    },
    "./app/bare": {
      "types": "./dist/app/bare.d.ts",
      "import": "./dist/app/bare.js"
    },
    "./config-types": {
      "types": "./dist/config-types/index.d.ts",
      "import": "./dist/config-types/index.js"
    },
    "./backends/*": {
      "types": "./dist/backends/*/index.d.ts",
      "import": "./dist/backends/*/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./entry-codecs/*": {
      "types": "./dist/entry-codecs/*/index.d.ts",
      "import": "./dist/entry-codecs/*/index.js"
    },
    "./lib/auth": {
      "types": "./dist/lib/auth/index.d.ts",
      "import": "./dist/lib/auth/index.js"
    },
    "./lib/backend": {
      "types": "./dist/lib/backend/index.d.ts",
      "import": "./dist/lib/backend/index.js"
    },
    "./lib/domain": {
      "types": "./dist/lib/domain/index.d.ts",
      "import": "./dist/lib/domain/index.js"
    },
    "./lib/util": {
      "types": "./dist/lib/util/index.d.ts",
      "import": "./dist/lib/util/index.js"
    },
    "./lib/widgets": {
      "types": "./dist/lib/widgets/index.d.ts",
      "import": "./dist/lib/widgets/index.js"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*/index.d.ts",
      "import": "./dist/locales/*/index.js"
    },
    "./media/*": {
      "types": "./dist/media/*/index.d.ts",
      "import": "./dist/media/*/index.js"
    },
    "./dev-server": {
      "types": "./dist/dev-server/index.d.ts",
      "import": "./dist/dev-server/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*/index.d.ts",
      "import": "./dist/ui/*/index.js"
    },
    "./ui-default": {
      "types": "./dist/ui/default/index.d.ts",
      "import": "./dist/ui/default/index.js"
    },
    "./ui-auth": {
      "types": "./dist/ui/auth/index.d.ts",
      "import": "./dist/ui/auth/index.js"
    },
    "./widgets/*": {
      "types": "./dist/widgets/*/index.d.ts",
      "import": "./dist/widgets/*/index.js"
