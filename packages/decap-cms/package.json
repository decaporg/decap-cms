    "react-colorful": "catalog:",
    "react-dnd": "catalog:",
    "react-dnd-html5-backend": "catalog:",
    "react-frame-component": "catalog:",
    "react-redux": "catalog:",
    "react-router-dom": "catalog:",
    "react-split-pane": "catalog:",
