    "redux": "catalog:",
    "redux-thunk": "catalog:",
    "rehype-parse": "^6.0.0",
    "rehype-remark": "^8.0.0",
    "rehype-remove-comments": "^4.0.2",
    "rehype-stringify": "^7.0.0",
    "remark-parse": "^6.0.3",
    "remark-rehype": "^4.0.0",
    "remark-stringify": "^6.0.4",
    "sanitize-html": "catalog:",
    "slate": "^0.118.1",
    "smol-toml": "catalog:",
    "unified": "^9.0.0",
    "unist-builder": "^1.0.3",
    "unist-util-visit-parents": "^2.0.1",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@apollo/client": "catalog:",
    "@babel/core": "catalog:",
    "@emotion/babel-plugin": "catalog:",
    "@emotion/eslint-plugin": "catalog:",
    "@eslint/js": "catalog:",
