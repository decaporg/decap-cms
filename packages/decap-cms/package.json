{
  "name": "decap-cms",
  "version": "4.0.0-beta.0",
  "description": "Decap CMS: a single package exposing the whole CMS through subpath exports. The root export is the app bootstrap. See restructure.md.",
  "license": "MIT",
  "homepage": "https://github.com/decaporg/decap-cms",
  "repository": {
    "type": "git",
    "url": "https://github.com/decaporg/decap-cms.git"
  },
  "bugs": {
    "url": "https://github.com/decaporg/decap-cms/issues"
  },
  "keywords": [
    "cms",
    "decap",
    "headless-cms",
    "content-management",
    "git-based-cms",
    "jamstack"
  ],
  "type": "module",
  "main": "dist/decap-cms.cjs",
  "unpkg": "dist/decap-cms.js",
  "jsdelivr": "dist/decap-cms.js",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "schema",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node ./scripts/postbuild-emotion.mjs && pnpm copy:assets && node ./scripts/generate-service-worker-asset.mjs dist/decap-cms-sw.js",
    "analyze": "node ./scripts/analyze.mjs",
    "analyze:demo": "ANALYZE=1 pnpm build:dev-test && open dev-test/dist/bundle-report-decap-cms.html",
    "build:cdn": "rimraf dist/decap-cms.js dist/decap-cms.esm.js dist/decap-cms.cjs && CDN_ENTRY=app vite build --config vite.config.cdn.ts && cp dist/decap-cms.js dist/decap-cms.cjs",
    "prepack": "pnpm build && pnpm build:cdn",
    "build:demo": "vite build --config vite.config.demo.ts",
    "build:demo-graphql": "vite build --config vite.config.demo-graphql.ts",
    "build:dev-test": "pnpm build:demo && node ./scripts/generate-service-worker-asset.mjs dev-test/decap-cms-sw.js",
    "serve:dev-test": "npx --yes serve dev-test -l 5174",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "dev": "vite build --config vite.config.demo.ts && (vite build --config vite.config.demo.ts --watch & BUILD_PID=$!; trap 'kill $BUILD_PID 2>/dev/null' EXIT INT TERM; npx --yes serve dev-test -l 5174)",
    "dev:lib": "pnpm copy:assets && (tsc-alias -p tsconfig.build.json --watch & tsc -p tsconfig.build.json --watch)",
    "copy:assets": "mkdir -p dist/widgets/code/data && cp src/widgets/code/data/languages.json dist/widgets/code/data/languages.json",
    "typecheck": "tsc --noEmit && tsc -p playwright --noEmit && tsc -p .storybook --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint --color \"src/**/*.{ts,tsx,js,mjs}\"",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "clean": "rimraf dist .turbo"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Opera versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 ChromeAndroid versions"
  ],
  "peerDependencies": {
    "@apollo/client": "^4.2.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "graphql": "^16.13.2 || ^17.0.0",
    "graphql-tag": "^2.12.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uploadcare-widget": "^3.23.4",
    "uploadcare-widget-tab-effects": "^1.7.2",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "graphql-tag": {
      "optional": true
    },
    "uploadcare-widget": {
      "optional": true
    },
    "uploadcare-widget-tab-effects": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
