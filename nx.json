{
  "targetDefaults": {
    "build:esm": {
      "cache": true,
      "dependsOn": ["^build:esm"],
      "outputs": ["{projectRoot}/dist/esm"]
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist/*.*", "{projectRoot}/dist/chunks"]
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [],
    "production": ["default"]
  },
  "analytics": false
}
