{
  "compilerOptions": {
    "declaration": false,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": false,
    "baseUrl": "./",
    "paths": {
      "decap-cms-core": ["packages/decap-cms-core/src"],
      "decap-cms-backend-bitbucket": ["packages/decap-cms-backend-bitbucket/src"],
      "decap-cms-backend-github": ["packages/decap-cms-backend-github/src"],
      "decap-cms-backend-gitlab": ["packages/decap-cms-backend-gitlab/src"],
      "decap-cms-lib-util": ["packages/decap-cms-lib-util/src"],
      "decap-cms-lib-widgets": ["packages/decap-cms-lib-widgets/src"],
      "decap-cms-ui-default": ["packages/decap-cms-ui-default/src"]
    }
  },
  // Cypress loads cypress.config.ts through ts-node, which runs in CommonJS.
  // Since TypeScript 5.0 that conflicts with the nodenext moduleResolution
  // above (TS5110), so ts-node gets a matching pair of its own.
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "Node"
    }
  },
  "include": ["**/src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
